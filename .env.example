# Resend (form delivery)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM="VIMTC Website <noreply@vimtc.org>"
MAIL_TO=dean@vimtc.org

# Cloudflare Turnstile (spam protection on forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://www.vimtc.org

# Supabase (form submission history; optional – forms still email without it)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for scripts/db-migrate.mjs and scripts/import-legacy-submissions.mjs (never set on Vercel)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:password@aws-0-us-west-1.pooler.supabase.com:5432/postgres
